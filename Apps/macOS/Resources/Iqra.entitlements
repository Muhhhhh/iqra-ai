<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Outgoing connections only, and only for reference recitation audio: the
	     reciter files are fetched from everyayah.com when you play or download an
	     āyah, then cached. Nothing that judges your recitation touches the network —
	     the speech model, the VAD, the tajweed model and the muṣḥaf are all bundled
	     and run on-device. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Deliberately absent: com.apple.security.network.server. The app never
	     listens for incoming connections. -->
</dict>
</plist>
